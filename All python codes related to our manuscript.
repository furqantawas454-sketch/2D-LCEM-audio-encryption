if n < 10:
    raise ValueError("At least 10 audio samples required.")


# ============================================================
# 3. THE 2D-LCEM HYPERCHAOTIC MAP
# ============================================================
#   x_{n+1} = [ 2^k (a+1) x_n (1 - x_n) + exp(cos(pi y_n))     ] mod 1
#   y_{n+1} = [ 2^k (b+1) y_n (1 - y_n) + exp(sin(pi x_{n+1})) ] mod 1

def lcem_orbit(x0, y0, a, b, count, discard=DISCARD, k=K_EXP):

    A = 2.0 ** k * (a + 1.0)
    B = 2.0 ** k * (b + 1.0)

    cos, sin, exp, pi = math.cos, math.sin, math.exp, math.pi

    x, y = x0, y0

    for _ in range(discard):
        x = (A * x * (1.0 - x) + exp(cos(pi * y))) % 1.0
        y = (B * y * (1.0 - y) + exp(sin(pi * x))) % 1.0

    xs = np.empty(count)
    ys = np.empty(count)

    for i in range(count):
        x = (A * x * (1.0 - x) + exp(cos(pi * y))) % 1.0
        y = (B * y * (1.0 - y) + exp(sin(pi * x))) % 1.0
        xs[i] = x
        ys[i] = y

    return xs, ys


def to_int(v, modulus):
    return np.floor(v * SCALE).astype(np.int64) % modulus


# ============================================================
# 4. KEY SCHEDULE (PLAINTEXT-DEPENDENT)
# ============================================================

def audio_digest(samples):
    return hashlib.sha256(samples.astype("<i2").tobytes()).digest()


def chaotic_material(key, digest, size):

    x0, y0, a, b = key

    # SHA-256 of the audio perturbs the initial values
    d1 = int.from_bytes(digest[:16], "big") / 2.0 ** 128
    d2 = int.from_bytes(digest[16:], "big") / 2.0 ** 128

    x0p = (x0 + d1) % 1.0
    y0p = (y0 + d2) % 1.0

    xs, ys = lcem_orbit(x0p, y0p, a, b, 2 * size + 1)

    X, Y = xs[:size], ys[:size]                  # confusion block
    KX, KY = xs[size:2 * size], ys[size:2 * size]  # diffusion block

    return {
        "X": X,
        "Y": Y,
        "P1": np.argsort(X, kind="stable"),
        "P2": np.argsort(Y, kind="stable"),
        "swap": ((to_int(X, 2**62) + to_int(Y, 2**62)) % 2).astype(bool),
        "K1": to_int(KX, MOD),
        "K2": to_int(KY, MOD),
        "IV1": int(to_int(np.array([xs[2 * size]]), MOD)[0]),
        "IV2": int(to_int(np.array([ys[2 * size]]), MOD)[0]),
    }


# ============================================================
# 5. CONFUSION: BIT-PLANE CROSS SCRAMBLING
# ============================================================

def confusion(u, m):
    """u: unsigned samples (0..65535). Permute high and low bytes with
    separate permutations, then cross-swap them at chaotic positions."""

    H, L = u >> 8, u & 0xFF

    H, L = H[m["P1"]], L[m["P2"]]

    s = m["swap"]
    H[s], L[s] = L[s].copy(), H[s].copy()

    return (H << 8) | L


def inverse_confusion(v, m):

    H, L = v >> 8, v & 0xFF

    s = m["swap"]
    H[s], L[s] = L[s].copy(), H[s].copy()

    H0 = np.empty_like(H)
    L0 = np.empty_like(L)
    H0[m["P1"]] = H
    L0[m["P2"]] = L

    return (H0 << 8) | L0


# ============================================================
# 6. DIFFUSION: BIDIRECTIONAL ADD-XOR CHAINING
# ============================================================
#   forward : c_i = ((v_i + K1_i) mod 2^16) XOR c_{i-1}
#   backward: e_i = ((c_i + K2_i) mod 2^16) XOR e_{i+1}

def diffuse(v, m):

    K1, K2 = m["K1"], m["K2"]
    size = len(v)

    c = np.empty(size, dtype=np.int64)
    prev = m["IV1"]
    for i in range(size):
        prev = ((int(v[i]) + int(K1[i])) & MASK) ^ prev
        c[i] = prev

    e = np.empty(size, dtype=np.int64)
    nxt = m["IV2"]
    for i in range(size - 1, -1, -1):
        nxt = ((int(c[i]) + int(K2[i])) & MASK) ^ nxt
        e[i] = nxt

    return e


def inverse_diffusion(e, m):

    K1, K2 = m["K1"], m["K2"]

    e_next = np.empty_like(e)
    e_next[:-1] = e[1:]
    e_next[-1] = m["IV2"]
    c = ((e ^ e_next) - K2) & MASK

    c_prev = np.empty_like(c)
    c_prev[1:] = c[:-1]
    c_prev[0] = m["IV1"]

    return ((c ^ c_prev) - K1) & MASK


# ============================================================
# 7. ENCRYPTION AND DECRYPTION
# ============================================================

def encrypt(samples, key):

    digest = audio_digest(samples)
    m = chaotic_material(key, digest, len(samples))

    u = samples.astype(np.int64) + 32768
    e = diffuse(confusion(u, m), m)

    return (e - 32768).astype(np.int16), digest, m


def decrypt(cipher, digest, key):

    m = chaotic_material(key, digest, len(cipher))

    e = cipher.astype(np.int64) + 32768
    u = inverse_confusion(inverse_diffusion(e, m), m)

    return (u - 32768).astype(np.int16)


start = time.perf_counter()
encrypted, DIGEST, material = encrypt(plain, KEY)
encryption_time = time.perf_counter() - start

start = time.perf_counter()
decrypted = decrypt(encrypted, DIGEST, KEY)
decryption_time = time.perf_counter() - start

