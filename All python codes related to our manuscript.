# ============================================================
# 18. KEY SENSITIVITY ANALYSIS
# ============================================================
# Each trial changes ONE key component by a tiny amount and
# encrypts the same plaintext again.

DELTA = {"x0": 1e-15, "y0": 1e-15, "a": 1e-14, "b": 1e-14}


def perturbed_key(name):
    k = list(KEY)
    idx = ["x0", "y0", "a", "b"].index(name)
    k[idx] += DELTA[name]
    return tuple(k)


def bit_difference(a, b):
    xor_bytes = (a.view(np.uint16) ^ b.view(np.uint16)).view(np.uint8)
    return 100.0 * np.unpackbits(xor_bytes).mean()


ks_npcr, ks_uaci, ks_bits = [], [], []
first_modified_cipher = None

print("\n========== KEY SENSITIVITY ==========")

for name in ["x0", "y0", "a", "b"]:

    k2 = perturbed_key(name)
    modified_cipher, _, _ = encrypt(plain, k2)

    if first_modified_cipher is None:
        first_modified_cipher = modified_cipher

    ks_npcr.append(npcr(encrypted, modified_cipher))
    ks_uaci.append(uaci(encrypted, modified_cipher))
    ks_bits.append(bit_difference(encrypted, modified_cipher))

    print(f"  {name} + {DELTA[name]:.0e} | NPCR = {ks_npcr[-1]:.6f}% | "
          f"UACI = {ks_uaci[-1]:.6f}% | Bit difference = {ks_bits[-1]:.4f}%")

print("\n---------- Key sensitivity summary (mean +/- std) ----------")
print(f"NPCR           : {np.mean(ks_npcr):.6f}% +/- {np.std(ks_npcr):.6f}   (ideal about 99.9985%)")
print(f"UACI           : {np.mean(ks_uaci):.6f}% +/- {np.std(ks_uaci):.6f}   (ideal about 33.334%)")
print(f"Bit difference : {np.mean(ks_bits):.4f}% +/- {np.std(ks_bits):.4f}   (ideal about 50%)")


