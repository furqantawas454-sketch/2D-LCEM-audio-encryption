"""
2D Logistic-Cosine Exponential Modular Map (2D-LCEM)
=====================================================

    x_{n+1} = { 2^k (a + 1) x_n (1 - x_n) + exp( cos(pi * y_n) )     }  mod 1
    y_{n+1} = { 2^k (b + 1) y_n (1 - y_n) + exp( sin(pi * x_{n+1}) ) }  mod 1

  Control parameters : a >= 0, b >= 0
  Scaling exponent   : integer k >= 6 (recommended default k = 10)
  State space        : [0, 1) x [0, 1)

Design ideas
  * 2^k (a+1) x(1-x)   : an amplified logistic term -> strong stretching in x
  * exp(cos(pi y))     : a bounded exponential-trigonometric coupling term with
                         range [1/e, e] (width > 2), so after "mod 1" it can push
                         x anywhere in [0,1) -> strong cross-mixing
  * using x_{n+1} inside the y-equation  -> sequential (tight) coupling
  * mod 1              : folding that keeps the orbit bounded for EVERY a, b >= 0
  * (a + 1)            : guarantees the stretching factor never vanishes, so the
                         map has no non-chaotic "dead" region at a = 0 or b = 0

Jacobian (mod 1 has derivative 1 almost everywhere):
    J11 = 2^k (a+1)(1 - 2x)
    J12 = -pi sin(pi y) exp(cos(pi y))
    J21 = g(x') * J11,             g(u) = pi cos(pi u) exp(sin(pi u))
    J22 = 2^k (b+1)(1 - 2y) + g(x') * J12
    det J = 2^{2k} (a+1)(b+1)(1 - 2x)(1 - 2y)      (coupling terms cancel)

All functions are vectorised: a, b, x, y may be numpy arrays of equal shape.
"""
import math
import numpy as np

PI = np.pi
DEFAULT_K = 10


def lcem_step(x, y, a, b, k=DEFAULT_K):
    """One iteration of 2D-LCEM (numpy-vectorised)."""
    A = 2.0 ** k * (a + 1.0)
    B = 2.0 ** k * (b + 1.0)
    x_new = np.mod(A * x * (1.0 - x) + np.exp(np.cos(PI * y)), 1.0)
    y_new = np.mod(B * y * (1.0 - y) + np.exp(np.sin(PI * x_new)), 1.0)
    return x_new, y_new


def lcem_jacobian(x, y, a, b, k=DEFAULT_K):
    """Return (J11, J12, J21, J22, x_new, y_new) at the point (x, y)."""
    A = 2.0 ** k * (a + 1.0)
    B = 2.0 ** k * (b + 1.0)
    x_new, y_new = lcem_step(x, y, a, b, k)
    J11 = A * (1.0 - 2.0 * x)
    J12 = -PI * np.sin(PI * y) * np.exp(np.cos(PI * y))
    g = PI * np.cos(PI * x_new) * np.exp(np.sin(PI * x_new))
    J21 = g * J11
    J22 = B * (1.0 - 2.0 * y) + g * J12
    return J11, J12, J21, J22, x_new, y_new


def lcem_sequence(x0, y0, a, b, k=DEFAULT_K, n=10000, discard=1000):
    """Generate n orbit points (fast scalar loop) after discarding transients."""
    A = 2.0 ** k * (a + 1.0)
    B = 2.0 ** k * (b + 1.0)
    x, y = float(x0), float(y0)
    cos, sin, exp, pi = math.cos, math.sin, math.exp, math.pi
    for _ in range(discard):
        x = (A * x * (1.0 - x) + exp(cos(pi * y))) % 1.0
        y = (B * y * (1.0 - y) + exp(sin(pi * x))) % 1.0
    xs = np.empty(n)
    ys = np.empty(n)
    for i in range(n):
        x = (A * x * (1.0 - x) + exp(cos(pi * y))) % 1.0
        y = (B * y * (1.0 - y) + exp(sin(pi * x))) % 1.0
        xs[i] = x
        ys[i] = y
    return xs, ys


def lyapunov_2d(jac_fn, a, b, x0=0.31, y0=0.47, n=5000, discard=500, **kw):
    """Both Lyapunov exponents of a 2D map by QR (Gram-Schmidt) re-orthonormalisation.

    jac_fn(x, y, a, b, **kw) -> (J11, J12, J21, J22, x_new, y_new).
    a and b may be arrays: all parameter values are iterated in parallel.
    Returns (LE1, LE2) arrays (unsorted; LE1 is the largest in practice).
    """
    a = np.asarray(a, dtype=float)
    b = np.asarray(b, dtype=float)
    shape = np.broadcast(a, b).shape
    a = np.broadcast_to(a, shape)
    b = np.broadcast_to(b, shape)
    x = np.full(shape, x0)
    y = np.full(shape, y0)
    with np.errstate(all="ignore"):
        for _ in range(discard):
            _, _, _, _, x, y = jac_fn(x, y, a, b, **kw)
        q11 = np.ones(shape); q21 = np.zeros(shape)
        q12 = np.zeros(shape); q22 = np.ones(shape)
        s1 = np.zeros(shape); s2 = np.zeros(shape)
        tiny = 1e-300
        for _ in range(n):
            J11, J12, J21, J22, x, y = jac_fn(x, y, a, b, **kw)
            m11 = J11 * q11 + J12 * q21
            m21 = J21 * q11 + J22 * q21
            m12 = J11 * q12 + J12 * q22
            m22 = J21 * q12 + J22 * q22
            r11 = np.sqrt(m11 ** 2 + m21 ** 2) + tiny
            q11 = m11 / r11; q21 = m21 / r11
            proj = q11 * m12 + q21 * m22
            v1 = m12 - proj * q11
            v2 = m22 - proj * q21
            r22 = np.sqrt(v1 ** 2 + v2 ** 2) + tiny
            q12 = v1 / r22; q22 = v2 / r22
            s1 += np.log(r11)
            s2 += np.log(r22)
    return s1 / n, s2 / n


if __name__ == "__main__":
    xs, ys = lcem_sequence(0.31, 0.47, a=2.0, b=3.0)
    print("first 5 x:", xs[:5])
    print("first 5 y:", ys[:5])
    l1, l2 = lyapunov_2d(lcem_jacobian, 2.0, 3.0, n=20000)
    print("Lyapunov exponents at a=2, b=3, k=10:", float(l1), float(l2))

