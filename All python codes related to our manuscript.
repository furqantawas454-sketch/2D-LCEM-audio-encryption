def orbit_2d(jac, a, b, x0, y0, n, discard=DISC):
    x, y = np.float64(x0), np.float64(y0)
    for _ in range(discard):
        *_, x, y = jac(x, y, a, b)
    xs, ys = np.empty(n), np.empty(n)
    for i in range(n):
        *_, x, y = jac(x, y, a, b)
        xs[i], ys[i] = x, y
    return xs, ys


def orbit_1d(f, r, x0, n, discard=DISC):
    x = x0
    for _ in range(discard):
        x = f(x, r)
    out = np.empty(n)
    for i in range(n):
        x = f(x, r)
        out[i] = x
    return out


def sample_entropy(s, m=2, r_frac=0.2):
    s = np.asarray(s, float)
    r = r_frac * s.std()
    if r == 0:
        return 0.0
    N = len(s)

    def count(mm):
        emb = np.lib.stride_tricks.sliding_window_view(s, mm)[: N - m]
        d = np.max(np.abs(emb[:, None, :] - emb[None, :, :]), axis=2)
        return (np.sum(d <= r) - len(emb)) / 2

    B, A = count(m), count(m + 1)
    if A == 0 or B == 0:
        return np.nan
    return -math.log(A / B)


def permutation_entropy(s, order=5):
    """Normalised permutation entropy (Bandt-Pompe), delay 1."""
    emb = np.lib.stride_tricks.sliding_window_view(np.asarray(s, float), order)
    ranks = np.argsort(emb, axis=1, kind="stable")
    codes = np.zeros(len(ranks), dtype=np.int64)
    for j in range(order):
        codes = codes * order + ranks[:, j]
    _, counts = np.unique(codes, return_counts=True)
    p = counts / counts.sum()
    return float(-(p * np.log(p)).sum() / math.log(math.factorial(order)))


rng01 = np.random.default_rng(2026)


def zero_one_test(phi, n_c=50):
    phi = np.asarray(phi, float)
    N = len(phi)
    ncut = N // 10
    j = np.arange(1, N + 1)
    Ks = []
    for c in rng01.uniform(PI / 5, 4 * PI / 5, n_c):
        p = np.cumsum(phi * np.cos(j * c))
        q = np.cumsum(phi * np.sin(j * c))
        ns = np.arange(1, ncut + 1)
        M = np.array([np.mean((p[k:] - p[:-k]) ** 2 + (q[k:] - q[:-k]) ** 2) for k in ns])
        D = M - (phi.mean() ** 2) * (1 - np.cos(ns * c)) / (1 - np.cos(c))
        Ks.append(np.corrcoef(ns, D)[0, 1])
    return float(np.median(Ks))



