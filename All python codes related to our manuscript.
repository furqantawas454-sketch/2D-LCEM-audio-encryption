"""
Audio encryption with the 2D-LCEM hyperchaotic map.

Scheme
  1. Key K = (x0, y0, a, b); k = 10 is fixed. SHA-256 of the audio perturbs
     the initial values, so each file gets its own chaotic sequence.
  2. Iterate 2D-LCEM: discard 1000 iterates, keep 2L (+1 for the IVs).
  3. Confusion: split each 16-bit sample into high/low bytes, permute each
     byte plane with its own chaotic permutation, then cross-swap high and
     low bytes at chaotically chosen positions.
  4. Diffusion: forward pass  c_i = ((v_i + K1_i) mod 2^16) XOR c_{i-1}
                backward pass e_i = ((c_i + K2_i) mod 2^16) XOR e_{i+1}
  5. Write the result as a 16-bit WAV of the same length.

Decryption runs the steps in reverse and is lossless. The SHA-256 digest
travels with the ciphertext (saved next to it as <file>.hash) and doubles
as an integrity check after decryption.

Usage
  python lcem_audio_cipher.py encrypt input.wav encrypted.wav
  python lcem_audio_cipher.py decrypt encrypted.wav decrypted.wav
  (optional: --x0 --y0 --a --b to set the key)

Requires: numpy, scipy
"""
import argparse
import hashlib
import math
import sys

import numpy as np
from scipy.io import wavfile

K_EXP = 10            # scaling exponent k of 2D-LCEM
DISCARD = 1000        # transient iterations
SCALE = 1e14          # used to extract integers from chaotic values
DEFAULT_KEY = (0.31415926535897, 0.27182818284590, 2.71828182845904, 3.14159265358979)


# ---------------------------------------------------------------------------
# 2D-LCEM map
# ---------------------------------------------------------------------------
def lcem_orbit(x0, y0, a, b, n, discard=DISCARD, k=K_EXP):
    """Return n points (x, y) of the 2D-LCEM orbit after `discard` transients."""
    A = 2.0 ** k * (a + 1.0)
    B = 2.0 ** k * (b + 1.0)
    cos, sin, exp, pi = math.cos, math.sin, math.exp, math.pi
    x, y = x0, y0
    for _ in range(discard):
        x = (A * x * (1.0 - x) + exp(cos(pi * y))) % 1.0
        y = (B * y * (1.0 - y) + exp(sin(pi * x))) % 1.0
    xs = np.empty(n)
    ys = np.empty(n)
    for i in range(n):
        x = (A * x * (1.0 - x) + exp(cos(pi * y))) % 1.0
        y = (B * y * (1.0 - y) + exp(sin(pi * x))) % 1.0
        xs[i] = x
        ys[i] = y
    return xs, ys


def to_int(v, modulus):
    """floor(v * 10^14) mod modulus, element-wise."""
    return (np.floor(v * SCALE).astype(np.int64) % modulus)


# ---------------------------------------------------------------------------
# Key schedule
# ---------------------------------------------------------------------------
def check_key(key):
    x0, y0, a, b = key
    if not (0.0 <= x0 < 1.0 and 0.0 <= y0 < 1.0):
        raise ValueError("x0 and y0 must lie in [0, 1)")
    if a < 0 or b < 0:
        raise ValueError("a and b must be non-negative")


def audio_digest(samples):
    """SHA-256 of the samples as little-endian int16 bytes."""
    return hashlib.sha256(samples.astype("<i2").tobytes()).digest()


def chaotic_material(key, digest, L):
    """Generate every pseudo-random quantity the cipher needs for L samples."""
    x0, y0, a, b = key
    d1 = int.from_bytes(digest[:16], "big") / 2.0 ** 128
    d2 = int.from_bytes(digest[16:], "big") / 2.0 ** 128
    x0p = (x0 + d1) % 1.0
    y0p = (y0 + d2) % 1.0

    xs, ys = lcem_orbit(x0p, y0p, a, b, 2 * L + 1)
    X, Y = xs[:L], ys[:L]                       # confusion block
    KX, KY = xs[L:2 * L], ys[L:2 * L]           # diffusion block

    return {
        "P1": np.argsort(X, kind="stable"),       # high-byte permutation
        "P2": np.argsort(Y, kind="stable"),       # low-byte permutation
        "swap": ((to_int(X, 2**62) + to_int(Y, 2**62)) % 2).astype(bool),
        "K1": to_int(KX, 65536),
        "K2": to_int(KY, 65536),
        "IV1": int(to_int(np.array([xs[2 * L]]), 65536)[0]),
        "IV2": int(to_int(np.array([ys[2 * L]]), 65536)[0]),
    }


# ---------------------------------------------------------------------------
# Core cipher on a 1-D int16 array
# ---------------------------------------------------------------------------
def encrypt_samples(samples, key=DEFAULT_KEY):
    """Encrypt a 1-D int16 array. Returns (cipher int16 array, sha256 digest)."""
    check_key(key)
    samples = np.asarray(samples, dtype=np.int16)
    L = samples.size
    digest = audio_digest(samples)
    m = chaotic_material(key, digest, L)

    u = samples.astype(np.int64) + 32768           # 0 .. 65535
    H, Lo = u >> 8, u & 0xFF

    # confusion: separate permutations, then cross-swap at chosen positions
    H, Lo = H[m["P1"]], Lo[m["P2"]]
    s = m["swap"]
    H[s], Lo[s] = Lo[s].copy(), H[s].copy()
    v = (H << 8) | Lo

    # diffusion: forward then backward, mixing mod-2^16 addition with XOR
    K1, K2 = m["K1"], m["K2"]
    c = np.empty(L, dtype=np.int64)
    prev = m["IV1"]
    for i in range(L):
        prev = ((v[i] + K1[i]) & 0xFFFF) ^ prev
        c[i] = prev
    e = np.empty(L, dtype=np.int64)
    nxt = m["IV2"]
    for i in range(L - 1, -1, -1):
        nxt = ((c[i] + K2[i]) & 0xFFFF) ^ nxt
        e[i] = nxt

    return (e - 32768).astype(np.int16), digest


def decrypt_samples(cipher, digest, key=DEFAULT_KEY):
    """Decrypt a 1-D int16 array produced by encrypt_samples."""
    check_key(key)
    cipher = np.asarray(cipher, dtype=np.int16)
    L = cipher.size
    m = chaotic_material(key, digest, L)
    K1, K2 = m["K1"], m["K2"]

    e = cipher.astype(np.int64) + 32768
    e_next = np.empty(L, dtype=np.int64)
    e_next[:-1] = e[1:]
    e_next[-1] = m["IV2"]
    c = ((e ^ e_next) - K2) & 0xFFFF                 # undo backward pass

    c_prev = np.empty(L, dtype=np.int64)
    c_prev[1:] = c[:-1]
    c_prev[0] = m["IV1"]
    v = ((c ^ c_prev) - K1) & 0xFFFF                 # undo forward pass

    H, Lo = v >> 8, v & 0xFF
    s = m["swap"]
    H[s], Lo[s] = Lo[s].copy(), H[s].copy()          # undo cross-swap
    H0 = np.empty(L, dtype=np.int64)
    L0 = np.empty(L, dtype=np.int64)
    H0[m["P1"]] = H                                  # undo permutations
    L0[m["P2"]] = Lo
    plain = ((H0 << 8) | L0) - 32768
    return plain.astype(np.int16)


# ---------------------------------------------------------------------------
# WAV helpers (mono or multichannel, 16-bit PCM)
# ---------------------------------------------------------------------------
def read_wav(path):
    rate, data = wavfile.read(path)
    if data.dtype != np.int16:
        raise ValueError(f"{path}: only 16-bit PCM WAV is supported (got {data.dtype})")
    return rate, data


def encrypt_wav(in_path, out_path, key=DEFAULT_KEY):
    rate, data = read_wav(in_path)
    cipher, digest = encrypt_samples(data.reshape(-1), key)   # channels interleaved
    wavfile.write(out_path, rate, cipher.reshape(data.shape))
    with open(out_path + ".hash", "w") as f:
        f.write(digest.hex())
    return digest


def decrypt_wav(in_path, out_path, key=DEFAULT_KEY, digest=None):
    rate, data = read_wav(in_path)
    if digest is None:
        with open(in_path + ".hash") as f:
            digest = bytes.fromhex(f.read().strip())
    plain = decrypt_samples(data.reshape(-1), digest, key)
    wavfile.write(out_path, rate, plain.reshape(data.shape))
    ok = audio_digest(plain) == digest
    return ok


# ---------------------------------------------------------------------------
def main(argv=None):
    p = argparse.ArgumentParser(description="2D-LCEM audio encryption (16-bit WAV)")
    p.add_argument("mode", choices=["encrypt", "decrypt"])
    p.add_argument("input")
    p.add_argument("output")
    p.add_argument("--x0", type=float, default=DEFAULT_KEY[0])
    p.add_argument("--y0", type=float, default=DEFAULT_KEY[1])
    p.add_argument("--a", type=float, default=DEFAULT_KEY[2])
    p.add_argument("--b", type=float, default=DEFAULT_KEY[3])
    args = p.parse_args(argv)
    key = (args.x0, args.y0, args.a, args.b)

    if args.mode == "encrypt":
        d = encrypt_wav(args.input, args.output, key)
        print(f"Encrypted -> {args.output}\nDigest saved -> {args.output}.hash ({d.hex()[:16]}...)")
    else:
        ok = decrypt_wav(args.input, args.output, key)
        print(f"Decrypted -> {args.output}")
        print("Integrity check:", "PASSED" if ok else "FAILED (wrong key or tampered file)")
        if not ok:
            sys.exit(1)


if __name__ == "__main__":
    main()

