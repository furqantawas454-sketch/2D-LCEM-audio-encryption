def slmm_jac(x, y, a, b):
    xn = a * (np.sin(PI * y) + b) * x * (1 - x)
    yn = a * (np.sin(PI * xn) + b) * y * (1 - y)
    J11 = a * (np.sin(PI * y) + b) * (1 - 2 * x)
    J12 = a * PI * np.cos(PI * y) * x * (1 - x)
    h = a * PI * np.cos(PI * xn) * y * (1 - y)
    return J11, J12, h * J11, a * (np.sin(PI * xn) + b) * (1 - 2 * y) + h * J12, xn, yn


def lscm_jac(x, y, th, _unused=None):
    u = 4 * th * x * (1 - x) + (1 - th) * np.sin(PI * y)
    xn = np.sin(PI * u)
    J11 = PI * np.cos(PI * u) * 4 * th * (1 - 2 * x)
    J12 = PI * np.cos(PI * u) * (1 - th) * PI * np.cos(PI * y)
    v = 4 * th * y * (1 - y) + (1 - th) * np.sin(PI * xn)
    yn = np.sin(PI * v)
    dv = (1 - th) * PI * np.cos(PI * xn)
    return J11, J12, PI * np.cos(PI * v) * dv * J11, PI * np.cos(PI * v) * (4 * th * (1 - 2 * y) + dv * J12), xn, yn


