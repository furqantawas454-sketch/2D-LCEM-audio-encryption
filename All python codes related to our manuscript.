npcr_value = npcr(encrypted, modified_encrypted)
uaci_value = uaci(encrypted, modified_encrypted)


# ============================================================
# 11. HISTOGRAM CHI-SQUARE ANALYSIS
# ============================================================

def histogram_chi_square(values):
    counts = np.bincount(values.astype(np.int64) + 32768, minlength=MOD)
    expected = len(values) / MOD
    return np.sum((counts - expected) ** 2 / expected)


original_chi = histogram_chi_square(plain)
encrypted_chi = histogram_chi_square(encrypted)
decrypted_chi = histogram_chi_square(decrypted)

# Critical value of chi-square with 65535 degrees of freedom at 5%
# (Wilson-Hilferty approximation)
dof = MOD - 1
chi_critical = dof * (1 - 2 / (9 * dof) + 1.6449 * math.sqrt(2 / (9 * dof))) ** 3


