# ============================================================
# 1. CONFIGURATION
# bird, alarm, female, and male speech
# ============================================================

AUDIO_PATH = r"C:\Users\sadda\Downloads\male speech.mp3.wav"

# Secret key K = (x0, y0, a, b):  x0, y0 in [0, 1),  a, b >= 0
KEY = (0.31415926535897, 0.27182818284590, 2.71828182845904, 3.14159265358979)

K_EXP = 10            # scaling exponent k of the 2D-LCEM map (fixed)
DISCARD = 1000        # transient iterations discarded
SCALE = 1e14          # extracts integers from chaotic values

MOD = 65536
MASK = 65535

# Set True to also save every figure as a 300-dpi PNG next to the audio file
SAVE_FIGURES = False
FIG_DIR = os.path.join(os.path.dirname(AUDIO_PATH), "lcem_figures")


# ============================================================
# 2. READ AUDIO FILE
# ============================================================

def load_as_int16(path):
    """Read a WAV file as int16. Converts 8/24/32-bit and float WAV.
    Falls back to librosa if the file is not a plain WAV (e.g. a renamed MP3)."""
    try:
        rate, data = wavfile.read(path)
    except Exception:
        import librosa                                   # pip install librosa
        y, rate = librosa.load(path, sr=None, mono=False)
        data = y.T if y.ndim == 2 else y
        print("Note: file is not a plain WAV; decoded with librosa.")

    if data.dtype == np.int16:
        return rate, data
    if data.dtype == np.uint8:
        out = (data.astype(np.int16) - 128) << 8
    elif data.dtype == np.int32:
        out = (data >> 16).astype(np.int16)
    else:
        out = np.int16(np.clip(data, -1.0, 1.0) * 32767)
    print(f"Note: converted {data.dtype} samples to 16-bit PCM.")
    return rate, out


sample_rate, audio = load_as_int16(AUDIO_PATH)

original_shape = audio.shape
channels = audio.shape[1] if audio.ndim > 1 else 1

# Interleave channels into one sequence; signed int16 samples
plain = np.ascontiguousarray(audio).reshape(-1).astype(np.int16)

