# ============================================================
# 9. SHANNON ENTROPY
# ============================================================

def entropy(values):
    counts = np.bincount(values.astype(np.int64) + 32768, minlength=MOD)
    p = counts[counts > 0] / len(values)
    return -np.sum(p * np.log2(p))


def ideal_entropy(size, bins=MOD):
    """Expected entropy of truly uniform data with this many samples
    (finite-sample limit; 16 bits is reached only as size -> infinity)."""
    rng = np.random.default_rng(0)
    return entropy(rng.integers(-32768, 32768, size).astype(np.int16))


original_entropy = entropy(plain)
encrypted_entropy = entropy(encrypted)
decrypted_entropy = entropy(decrypted)
reference_entropy = ideal_entropy(n)


# ============================================================
# 10. NSCR / NPCR AND UACI (ONE-BIT PLAINTEXT CHANGE)
# ============================================================

def npcr(a, b):
    return 100.0 * np.mean(a != b)


def uaci(a, b):
    d = np.abs(a.astype(np.float64) - b.astype(np.float64))
    return 100.0 * np.mean(d / MASK)


modified_plain = plain.copy()
