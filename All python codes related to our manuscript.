"""
A subset of the NIST SP 800-22 Rev. 1a statistical tests, implemented from the
formulas in the specification. Input: a numpy array of 0/1 integers.
Each function returns a list of P-values (most return one).
"""
import math
import numpy as np
from scipy.special import gammaincc, erfc
from scipy.stats import norm


def frequency(bits):
    n = bits.size
    s = np.sum(2 * bits.astype(np.int64) - 1)
    return [erfc(abs(s) / math.sqrt(n) / math.sqrt(2))]


def block_frequency(bits, M=128):
    n = bits.size
    N = n // M
    blocks = bits[: N * M].reshape(N, M)
    pi = blocks.mean(axis=1)
    chi2 = 4 * M * np.sum((pi - 0.5) ** 2)
    return [gammaincc(N / 2, chi2 / 2)]


def _cusum_p(n, z):
    k1 = np.arange(math.floor((-n / z + 1) / 4), math.floor((n / z - 1) / 4) + 1)
    k2 = np.arange(math.floor((-n / z - 3) / 4), math.floor((n / z - 1) / 4) + 1)
    sq = math.sqrt(n)
    s1 = np.sum(norm.cdf((4 * k1 + 1) * z / sq) - norm.cdf((4 * k1 - 1) * z / sq))
    s2 = np.sum(norm.cdf((4 * k2 + 3) * z / sq) - norm.cdf((4 * k2 + 1) * z / sq))
    return 1 - s1 + s2


def cumulative_sums(bits):
    x = 2 * bits.astype(np.int64) - 1
    n = x.size
    zf = np.max(np.abs(np.cumsum(x)))
    zb = np.max(np.abs(np.cumsum(x[::-1])))
    return [_cusum_p(n, zf), _cusum_p(n, zb)]


def runs(bits):
    n = bits.size
    pi = bits.mean()
    if abs(pi - 0.5) >= 2 / math.sqrt(n):
        return [0.0]
    v = 1 + np.count_nonzero(bits[1:] != bits[:-1])
    return [erfc(abs(v - 2 * n * pi * (1 - pi)) / (2 * math.sqrt(2 * n) * pi * (1 - pi)))]


def longest_run(bits):
    """Longest run of ones in a block, M = 10^4 (requires n >= 750000)."""
    M, K, N = 10000, 6, 75
    pis = [0.0882, 0.2092, 0.2483, 0.1933, 0.1208, 0.0675, 0.0727]
    blocks = bits[: N * M].reshape(N, M)
    counts = np.zeros(K + 1)
    for blk in blocks:
        padded = np.concatenate(([0], blk, [0]))
        d = np.diff(padded)
        starts = np.flatnonzero(d == 1)
        ends = np.flatnonzero(d == -1)
        longest = int(np.max(ends - starts)) if starts.size else 0
        idx = min(max(longest, 10), 16) - 10
        counts[idx] += 1
    chi2 = np.sum((counts - N * np.array(pis)) ** 2 / (N * np.array(pis)))
    return [gammaincc(K / 2, chi2 / 2)]


def _block_counts(bits, m):
    """Counts of all overlapping m-bit patterns, with wrap-around."""
    n = bits.size
    ext = np.concatenate((bits, bits[: m - 1])).astype(np.int64)
    val = np.zeros(n, dtype=np.int64)
    for j in range(m):
        val = (val << 1) | ext[j: j + n]
    return np.bincount(val, minlength=2 ** m)


def _psi2(bits, m):
    if m <= 0:
        return 0.0
    n = bits.size
    c = _block_counts(bits, m).astype(np.float64)
    return (2 ** m / n) * np.sum(c ** 2) - n


def serial(bits, m=16):
    p0, p1, p2 = _psi2(bits, m), _psi2(bits, m - 1), _psi2(bits, m - 2)
    d1 = p0 - p1
    d2 = p0 - 2 * p1 + p2
    return [gammaincc(2 ** (m - 2), d1 / 2), gammaincc(2 ** (m - 3), d2 / 2)]


def approximate_entropy(bits, m=10):
    n = bits.size

    def phi(mm):
        c = _block_counts(bits, mm).astype(np.float64) / n
        c = c[c > 0]
        return np.sum(c * np.log(c))

    apen = phi(m) - phi(m + 1)
    chi2 = 2 * n * (math.log(2) - apen)
    return [gammaincc(2 ** (m - 1), chi2 / 2)]


TESTS = {
    "Frequency (monobit)": frequency,
    "Block frequency (M=128)": block_frequency,
    "Cumulative sums": cumulative_sums,
    "Runs": runs,
    "Longest run of ones (M=10^4)": longest_run,
    "Serial (m=16)": serial,
    "Approximate entropy (m=10)": approximate_entropy,
}


def run_battery(sequences, alpha=0.01):
    """Apply every test to every sequence. Returns {test: (pass proportion, P_T uniformity)}
    following NIST's proportion and P-value uniformity criteria."""
    results = {}
    for name, fn in TESTS.items():
        pvals = []
        for bits in sequences:
            pvals.append(fn(bits))
        pvals = np.array(pvals)                      # shape (num_seq, num_subtests)
        props, pts = [], []
        for j in range(pvals.shape[1]):
            p = pvals[:, j]
            props.append(np.mean(p >= alpha))
            counts = np.histogram(p, bins=10, range=(0, 1))[0]
            s = len(p)
            chi2 = np.sum((counts - s / 10) ** 2 / (s / 10))
            pts.append(gammaincc(9 / 2, chi2 / 2))
        results[name] = (min(props), min(pts))
    return results

